# 在 Neon 免费项目复制连接字符串。仅服务端使用，不要添加 NEXT_PUBLIC_ 前缀。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 各生成一个
SESSION_SECRET=
IP_HMAC_SECRET=
# 至少 12 位，设置你自己的强密码
ADMIN_PASSWORD=
# 生产域名确定后填写，不带末尾斜杠；本地可留空
APP_ORIGIN=
